Assignment - 1 creating Functions and Objects 

class Calculator:

    def add(self, a, b):
        return a + b

    def subtract(self, a, b):
        return a - b

    def multiply(self, a, b):
        return a * b

    def divide(self, a, b):
        if b == 0:
            return "Cannot divide by zero"
        return a / b



calc = Calculator()

print("Result of 5 + 3 =", calc.add(5, 3))
print("Result of 5 - 3 =", calc.subtract(5, 3))
print("Result of 5 * 3 =", calc.multiply(5, 3))
print("Result of 5 / 3 =", calc.divide(5, 3))
