#Asgn - 10 Composition

class Engine:
    def start(self):
        print("Engine Started")
    def stop(self):
        print("Engine Stopped")
class Car:
    def __init__(self):
        self.engine=Engine()  # Composition
    def start_car(self):
        print("Car Starting...")
        self.engine.start()
    def stop_car(self):
        print("Car Stopping...")
        self.engine.stop()

def main():
    car=Car()

    car.start_car()
    car.stop_car()

main()
