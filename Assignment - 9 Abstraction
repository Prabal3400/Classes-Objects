# Assgn - 9 Abstraction

from abc import ABC, abstractmethod

class Payment(ABC):
    @abstractmethod
    def make_payment(self,amount):
        pass
class UPI(Payment):
    def make_payment(self,amount):
        print("Paid Rs.", amount, "using UPI") 

class CreditCard(Payment):
    def make_payment(self,amount):
        print("Paid Rs.", amount, "using Credit Card") 

class NetBanking(Payment):
    def make_payment(self,amount):
        print("Paid Rs.", amount, "using Net Banking") 

def main():
    payment1=UPI()
    payment1.make_payment(1000)

    payment2=CreditCard()
    payment2.make_payment(2000)

    payment3=NetBanking()
    payment3.make_payment(3000)

main()
